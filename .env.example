# ── Base de données (obligatoire en production) ─────────────────────
# PostgreSQL (Neon, Supabase, Vercel Postgres…). Sans elle, les données vont
# dans un fichier local .data/ : à n’utiliser qu’en développement.
DATABASE_URL=postgres://user:password@host:5432/une_formule?sslmode=require

# ── Paiement KkiaPay (tableau de bord KkiaPay → Développeurs → Clés API) ──
# Toutes ces variables restent côté serveur : type « Secret » sur Vercel.
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
# true = mode test (sandbox), false = vrais paiements
KKIAPAY_SANDBOX=true
# Facultatif : secret « hash » du webhook KkiaPay
# URL à déclarer : https://www.uneformule.com/api/payments/kkiapay/webhook
KKIAPAY_WEBHOOK_SECRET=

# ── Facultatif ──────────────────────────────────────────────────────
# Les comptes admin sont dans la base (commande : pnpm admin:create).
# Le secret des sessions est généré et gardé en base ; on peut l’imposer ici (32 caractères min.).
# SESSION_SECRET=
# NUXT_PUBLIC_SITE_URL=https://www.uneformule.com
# NUXT_PUBLIC_GA_ID=G-XXXXXXX
# REDIS_URL=redis://…   (limitation anti-abus partagée entre instances)
