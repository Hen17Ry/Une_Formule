# ── Base de données (obligatoire en production) ─────────────────────
# PostgreSQL (Neon, Supabase, Vercel Postgres…). Sans elle, les données vont
# dans un fichier local .data/ : à n’utiliser qu’en développement.
DATABASE_URL=postgres://user:password@host:5432/une_formule?sslmode=require

# ── Administration ──────────────────────────────────────────────────
# Le compte admin est créé (ou son mot de passe mis à jour) au démarrage.
NUXT_ADMIN_EMAIL=admin@uneformule.com
NUXT_ADMIN_PASSWORD=change-moi-avec-au-moins-10-caracteres
# Secret de chiffrement des sessions : 32 caractères minimum (openssl rand -hex 32)
NUXT_SESSION_PASSWORD=

# ── Paiement KkiaPay (tableau de bord KkiaPay → Développeurs → Clés API) ──
NUXT_PUBLIC_KKIAPAY_PUBLIC_KEY=
NUXT_KKIAPAY_PRIVATE_KEY=
NUXT_KKIAPAY_SECRET_KEY=
# true = mode test (sandbox), false = vrais paiements
NUXT_PUBLIC_KKIAPAY_SANDBOX=true
# Secret « hash » défini sur le webhook KkiaPay ; URL : https://www.uneformule.com/api/payments/kkiapay/webhook
NUXT_KKIAPAY_WEBHOOK_SECRET=

# ── Divers ──────────────────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL=https://www.uneformule.com
# NUXT_PUBLIC_GA_ID=G-XXXXXXX
# REDIS_URL=redis://…   (facultatif : limitation anti-abus partagée entre instances)
